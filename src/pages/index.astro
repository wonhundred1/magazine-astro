---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Sigorhaus Magazine | Geoje & the southern coast">
  <section class="hero">
    <h1>English notes from a quieter Korea</h1>
    <p class="lede">
      Sigorhaus Magazine is a small English travel magazine for visitors arriving through Busan
      and looking for places with a real story. We start in Geoje.
    </p>
  </section>

  {posts.map((post) => (
    <a class="card" href={`/posts/${post.id}/`}>
      <p class="meta">{post.data.region} · {post.data.pubDate.toISOString().slice(0, 10)}{post.data.updatedDate ? ` · updated ${post.data.updatedDate.toISOString().slice(0, 10)}` : ''}</p>
      <h2>{post.data.title}</h2>
      <p>{post.data.description}</p>
    </a>
  ))}
</BaseLayout>