---
import '../styles/global.css';
const { title = 'Sigorhaus Magazine', description = 'Place with accuracy. Stories with warmth. Sources made clear.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="qI-cpuucg7zYE8szHQvyh1HWnVmg67oW2e_CbV4-POU" />
    <link rel="icon" type="image/png" href="/favicon-sigorhaus.png" sizes="64x64" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-top">
        <a class="brand" href="/">Sigorhaus Magazine</a>
        <nav class="header-nav" aria-label="English site links">
          <a href="https://sigorhaus.com/en/">English home</a>
          <a href="https://sigorhaus.com/">한국어 홈</a>
        </nav>
      </div>
      <p class="tagline">Place with accuracy · Stories with warmth · Sources made clear</p>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>A quiet English magazine from Geoje and the southern coast of Korea.</p>
      <p class="footer-links">
        <a href="https://sigorhaus.com/en/">sigorhaus.com/en</a>
        · <a href="/">Magazine home</a>
        · <a href="https://blog.sigorhaus.com/">Korean blog</a>
        · <a href="mailto:sigorhaus@gmail.com">sigorhaus@gmail.com</a>
      </p>
    </footer>
  </body>
</html>
